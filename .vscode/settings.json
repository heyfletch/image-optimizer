{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/.git/**": true
  },
  "files.exclude": {
    "**/node_modules/**": true,
    "src-tauri/target/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "src-tauri/target/**": true,
    "**/dist/**": true
  },
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.checkOnSave": false
}
